HINDSIGHT_API_KEY=your-hindsight-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Optional, defaults to Hindsight Cloud. Set for a self-hosted server.
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# OmniRoute API key from its dashboard (API Manager). Falls back to ANTHROPIC_API_KEY.
OMNIROUTE_API_KEY=
# Model id as listed by OmniRoute /v1/models.
AGENT_MODEL=claude-opus-5
